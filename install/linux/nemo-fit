#!/bin/bash
# nemo-fit: a llama-server built for THIS machine's CPU, kept on the stick
# (owner, 2026-11-11: "giving nemodoc on nemoiso the ability to write [a]
# version on [the] stick of nemo that works with [the] system it's running on").
#
# The image carries one llama-server, built with nothing newer than SSE4.2
# so that it starts on the AH531's Pentium (O15). On a newer CPU it runs,
# but without the AVX/AVX2 instructions that CPU has. This builds the same
# pinned release for this CPU's level and keeps it in ~/.nemo/engines,
# which nemo-sync saves to NemoData on the stick: the next boot on a machine
# of the same level uses it with no network and no build.
#
#   nemo-fit level     print this CPU's level: sse42, avx or avx2
#   nemo-fit find      print the folder of a kept engine for this level whose
#                      file matches the sha256 written when it was built;
#                      1 if none. Reads only.
#   nemo-fit use       find, then make it runnable and start it once
#                      (--version); prints the folder; 1 if it fails
#   nemo-fit build     build one for this level (network, cmake, a compiler;
#                      all three are in the image). Nothing for sse42: the
#                      image's own build is that one.
#
# A kept engine is used only on a CPU of the SAME level, and only if its
# hash still matches: a stick goes between machines, and a FAT stick can be
# damaged (2026-11-11: D:\Nemo\dist was found unreadable on the desktop).
set -u

STATE="${NEMO_HOME:-$HOME/.nemo}"
ENGINES="$STATE/engines"
HERE="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
CPUINFO="${NEMO_CPUINFO:-/proc/cpuinfo}"   # a test gives its own
WORK="${NEMO_FIT_WORK:-/var/tmp}"          # where the source is built (a test gives its own)
TAG="b11175"                               # build-llama.sh's and nemodoc's pin

level() {
    local flags
    flags=" $(grep -m1 '^flags' "$CPUINFO" 2>/dev/null | cut -d: -f2) "
    has() { case "$flags" in *" $1 "*) return 0 ;; *) return 1 ;; esac; }
    # AVX2 came with FMA, F16C and BMI2 (Haswell); the build switches all
    # four on, so all four must be there. A CPU with AVX alone (Sandy and
    # Ivy Bridge) gets the --avx build.
    if has avx2 && has fma && has f16c && has bmi2; then echo avx2
    elif has avx; then echo avx
    else echo sse42; fi
}

folder() { echo "$ENGINES/$TAG-$1"; }

find_kept() {
    local lv dir want got
    lv="$(level)"
    [ "$lv" = sse42 ] && return 1
    dir="$(folder "$lv")"
    [ -f "$dir/llama-server" ] && [ -f "$dir/BUILT.txt" ] || return 1
    want="$(sed -n 's/^sha256 //p' "$dir/BUILT.txt")"
    got="$(sha256sum "$dir/llama-server" | cut -d' ' -f1)"
    [ -n "$want" ] && [ "$want" = "$got" ] || { echo "nemo-fit: $dir/llama-server does not match its hash" >&2; return 1; }
    echo "$dir"
}

use() {
    local dir
    dir="$(find_kept)" || return 1
    chmod 0755 "$dir/llama-server"         # FAT keeps no permissions
    "$dir/llama-server" --version >/dev/null 2>&1 || { echo "nemo-fit: $dir/llama-server does not start on this CPU" >&2; return 1; }
    echo "$dir"
}

build() {
    local lv dir tmp sum
    lv="$(level)"
    if [ "$lv" = sse42 ]; then echo "nemo-fit: this CPU's level is SSE4.2: the image's own llama-server is built for it"; return 0; fi
    dir="$(folder "$lv")"
    tmp="$(mktemp -d "$WORK/nemo-fit.XXXXXX")" || return 1
    # build-llama.sh starts what it built before it says yes (an engine that
    # does not start here is not kept).
    if ! NEMO_BUILD_DIR="$tmp/src" "$HERE/build-llama.sh" "--$lv" "$tmp/out"; then
        rm -rf "$tmp"; echo "nemo-fit: the build failed" >&2; return 1
    fi
    mkdir -p "$dir"
    mv -f "$tmp/out/bin/llama-server" "$dir/llama-server"
    rm -rf "$tmp"
    sum="$(sha256sum "$dir/llama-server" | cut -d' ' -f1)"
    {
        echo "llama.cpp $TAG, level $lv"
        echo "cpu $(grep -m1 '^model name' "$CPUINFO" | cut -d: -f2 | sed 's/^ *//')"
        echo "built $(date '+%Y-%m-%d %H:%M')"
        echo "sha256 $sum"
    } > "$dir/BUILT.txt"
    echo "nemo-fit: built for $lv, kept in $dir"
}

case "${1:-}" in
    level) level ;;
    find)  find_kept ;;
    use)   use ;;
    build) build ;;
    *) echo "usage: nemo-fit level|find|use|build" >&2; exit 2 ;;
esac
